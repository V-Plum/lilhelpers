#include <windows.h>

1   ICON   "lilhelpers.ico"
1   24     "lilhelpers.manifest"
100 RCDATA "lilhelpers.png"
// CAPS-83: розширення браузера — «Розширення…» розкладає його в %LOCALAPPDATA%
101 RCDATA "browser-extension/manifest.json"
102 RCDATA "browser-extension/background.js"
103 RCDATA "browser-extension/popup.html"
104 RCDATA "browser-extension/popup.js"
105 RCDATA "browser-extension/icon16.png"
106 RCDATA "browser-extension/icon32.png"
107 RCDATA "browser-extension/icon48.png"
108 RCDATA "browser-extension/icon128.png"
// CAPS-84: переглядач звіту (той самий у звіті HTML і в розширенні)
109 RCDATA "browser-extension/viewer.html"
110 RCDATA "browser-extension/viewer.js"
111 RCDATA "browser-extension/report.css"
112 RCDATA "browser-extension/report.js"
113 RCDATA "browser-extension/report.html"

// Version metadata. Without it the exe looks anonymous, which is one of the
// signals antivirus ML heuristics weigh when flagging unsigned binaries.
// Keep this file ASCII-only: rc.exe reads it as ANSI unless told otherwise.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     4,13,2,0
PRODUCTVERSION  4,13,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Plum"
            VALUE "FileDescription",  "Little Helpers - small Windows conveniences"
            VALUE "FileVersion",      "4.13.2.0"
            VALUE "InternalName",     "lilhelpers"
            VALUE "LegalCopyright",   "(c) 2026 Vadym Slyva (Plum)"
            VALUE "OriginalFilename", "lilhelpers.exe"
            VALUE "ProductName",      "Little Helpers"
            VALUE "ProductVersion",   "4.13.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
