{
  "manifest_version": 3,
  "name": "Little Helpers — DevTools log",
  "short_name": "Little Helpers",
  "version": "1.0.0",
  "description": "Writes the page's console, errors, network and navigations while Little Helpers records the screen, in sync with the video.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Little Helpers", "default_popup": "popup.html" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
